# Copy this file to .env and fill in your own values. Never commit .env.

# Cloud model: gemini. (mock gives canned answers for tests and needs no key.)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Main model for the specialists, and a smaller, faster model for the router.
# Use model ids from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=
ROUTER_MODEL=

# Speech-to-text: deepgram. (mock needs no key; tests only.)
STT_PROVIDER=deepgram
STT_API_KEY=

# Text-to-speech: deepgram, with the same key as above. (mock produces silence.)
TTS_PROVIDER=deepgram
TTS_API_KEY=

# Where the extension's voice shell connects. Read when the extension is built.
BACKEND_WS_URL=ws://127.0.0.1:8000/ws
