# Copy this file to .env and fill in your own values. Never commit .env.

# Cloud model. LLM_PROVIDER=mock gives canned answers for tests and needs no key.
LLM_PROVIDER=
LLM_API_KEY=
# Main model for the specialists, and a smaller, faster model for the router.
LLM_MODEL=
ROUTER_MODEL=

# Speech-to-text. STT_PROVIDER=mock needs no key (tests only).
STT_PROVIDER=
STT_API_KEY=

# Text-to-speech. TTS_PROVIDER=mock needs no key (tests only; it produces silence).
TTS_PROVIDER=
TTS_API_KEY=

# Where the extension's voice shell connects. Read when the extension is built.
BACKEND_WS_URL=ws://127.0.0.1:8000/ws
